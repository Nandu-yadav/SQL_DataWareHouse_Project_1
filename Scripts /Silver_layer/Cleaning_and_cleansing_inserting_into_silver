

USE Datawarehouse2;
GO

CREATE OR ALTER PROCEDURE silver.load_silver
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @batch_start_time DATETIME2 = SYSDATETIME();
    DECLARE @table_start_time DATETIME2;

    BEGIN TRY

        PRINT '================================================';
        PRINT 'SILVER LAYER LOAD STARTED';
        PRINT 'Start Time: ' + CONVERT(VARCHAR(30), @batch_start_time, 121);
        PRINT '================================================';

        -- ==========================================
        -- 1. CRM CUSTOMER INFO
        -- ==========================================
        SET @table_start_time = SYSDATETIME();

        PRINT '>> Truncating Table: silver.crm_cust_info';
        TRUNCATE TABLE silver.crm_cust_info;

        PRINT '>> Inserting Data: silver.crm_cust_info';

        TRUNCATE TABLE silver.crm_cust_info
		INSERT INTO silver.crm_cust_info(
		t.cst_id,
		t.cst_key,
		cst_firstname,
		cst_lastname,
		cst_marital_status,
		cst_gndr,
		cst_create_date
		)
		select 
		t.cst_id,
		t.cst_key,
		TRIM(t.cst_firstname) as cst_firstname,
		TRIM(t.cst_lastname) as cst_lastname,
		CASE trim(UPPER(t.cst_material_status))
			 WHEN 'S'  THEN 'Single'
			 WHEN 'M'  THEN  'Married'
			 ELSE 'n/a'
		end cst_marital_status,
		CASE trim(UPPER(cst_gndr))
			 WHEN 'M'  THEN 'Male'
			 WHEN 'F'  THEN  'Female'
			 ELSE 'n/a'
		end cst_gndr,
		t.cst_create_date
		FROM (select *,
		ROW_NUMBER() OVER(PARTITION BY cst_id ORDER BY TRY_CONVERT (DATE,cst_create_date) desc) AS flag_last
		FROM bronze.crm_cust_info)t
		where flag_last = 1 

--================================================================================================

        PRINT '>> Completed: silver.crm_cust_info';
        PRINT '>> Duration (seconds): '
            + CAST(DATEDIFF(SECOND, @table_start_time, SYSDATETIME()) AS VARCHAR(20));

        -- ==========================================
        -- 2. CRM PRODUCT INFO
        -- ==========================================
        SET @table_start_time = SYSDATETIME();

        PRINT '>> Truncating Table: silver.crm_prd_info';
        TRUNCATE TABLE silver.crm_prd_info;

        PRINT '>> Inserting Data: silver.crm_prd_info';

       TRUNCATE TABLE silver.crm_prd_info
		INSERT INTO silver.crm_prd_info(
		prd_id,
		cat_id,
		prd_key,
		prd_cost,
		prd_nm,
		prd_line,
		prd_start_dt,
		prd_end_dt)
		SELECT
			prd_id,
			REPLACE(SUBSTRING(prd_key, 1, 5), '-', '_') AS cat_id,
			SUBSTRING(prd_key, 7, LEN(prd_key)) AS prd_key,
			ISNULL(prd_cost, 0) AS prd_cost,
			prd_nm,
			CASE UPPER(TRIM(prd_line))
				WHEN 'M' THEN 'Mountain'
				WHEN 'R' THEN 'Road'
				WHEN 'S' THEN 'Other Sales'
				WHEN 'T' THEN 'Touring'
				ELSE 'n/a'
			END AS prd_line,
			prd_start_dt,
			DATEADD( DAY,-1,LEAD(CAST(prd_start_dt AS DATE) ) OVER (PARTITION BY prd_key ORDER BY prd_start_dt) ) AS prd_end_dt
		FROM bronze.crm_prd_info;
--==============================================================================================

        PRINT '>> Completed: silver.crm_prd_info';
        PRINT '>> Duration (seconds): '
            + CAST(DATEDIFF(SECOND, @table_start_time, SYSDATETIME()) AS VARCHAR(20));

        -- ==========================================
        -- 3. CRM SALES DETAILS
        -- ==========================================
        SET @table_start_time = SYSDATETIME();

        PRINT '>> Truncating Table: silver.crm_sales_details';
        TRUNCATE TABLE silver.crm_sales_details;

        PRINT '>> Inserting Data: silver.crm_sales_details';

       TRUNCATE TABLE silver.crm_sales_details
			-- Insert cleaned data from Bronze into Silver
		INSERT INTO silver.crm_sales_details (
			sls_ord_num,
			sls_prd_key,
			sls_cust_id,
			sls_order_dt,
			sls_ship_dt,
			sls_due_dt,
			sls_sales,
			sls_quantity,
			sls_price
		)
		SELECT
			b.sls_ord_num,
			b.sls_prd_key,
			b.sls_cust_id,
	
			-- Order date: source is NVARCHAR in YYYYMMDD format
			CASE
				WHEN LEN(TRIM(b.sls_order_dt)) = 8
				THEN TRY_CONVERT(DATE, TRIM(b.sls_order_dt), 112)
				ELSE NULL
			END AS sls_order_dt,

		-- These source columns are already DATE
		b.sls_ship_dt,
		b.sls_due_dt,

		-- Correct sales using the cleaned price when possible
		CASE
			WHEN b.sls_sales IS NULL OR b.sls_sales <= 0
			THEN calc.calculated_sales

			WHEN p.price_value IS NOT NULL
			 AND b.sls_quantity IS NOT NULL
			 AND b.sls_sales <>
				 b.sls_quantity * ABS(p.price_value)
			THEN calc.calculated_sales

			ELSE b.sls_sales
		END AS sls_sales,

		b.sls_quantity,

		-- Replace invalid price using sales / quantity
		CASE
			WHEN p.price_value IS NULL OR p.price_value <= 0
			THEN CASE
					 WHEN b.sls_sales > 0
					  AND b.sls_quantity > 0
					 THEN b.sls_sales / NULLIF(b.sls_quantity, 0)
					 ELSE NULL
				 END
			ELSE ABS(p.price_value)
		END AS sls_price

	FROM bronze.crm_sales_details AS b

	CROSS APPLY (
		SELECT TRY_CONVERT(INT, TRIM(b.sls_price)) AS price_value
	) AS p

	CROSS APPLY (
		SELECT
			CASE
				WHEN p.price_value IS NOT NULL
				 AND b.sls_quantity IS NOT NULL
				THEN b.sls_quantity * ABS(p.price_value)
				ELSE NULL
			END AS calculated_sales
	) AS calc;


	--==================================================================================================

        PRINT '>> Completed: silver.crm_sales_details';
        PRINT '>> Duration (seconds): '
            + CAST(DATEDIFF(SECOND, @table_start_time, SYSDATETIME()) AS VARCHAR(20));

        -- ==========================================
        -- 4. ERP CUSTOMER AZ12
        -- ==========================================
        SET @table_start_time = SYSDATETIME();

        PRINT '>> Truncating Table: silver.erp_cust_az12';
        TRUNCATE TABLE silver.erp_cust_az12;

        PRINT '>> Inserting Data: silver.erp_cust_az12';

		 INSERT INTO silver.erp_cust_az12(cid,bdate,gen)
		
		SELECT 
			CASE WHEN cid LIKE 'NAS%' THEN SUBSTRING(cid,4,LEN(cid))
				ELSE cid
			END as cid,
			CASE WHEN  bdate > GETdate() THEN NULL
				 ELSE bdate
			END AS bdate,
			CASE WHEN  UPPER(TRIM(gen)) IN  ('M','MALE') THEN 'Male'
				 WHEN  UPPER(TRIM(gen)) IN  ('F','FEMALE') THEN 'Female'
				ELSE 'N/A'
			END AS gen
		from bronze.erp_cust_az12

        PRINT '>> Completed: silver.erp_cust_az12';
        PRINT '>> Duration (seconds): '
            + CAST(DATEDIFF(SECOND, @table_start_time, SYSDATETIME()) AS VARCHAR(20));

        -- ==========================================
        -- 5. ERP LOCATION
        -- ==========================================
        SET @table_start_time = SYSDATETIME();

        PRINT '>> Truncating Table: silver.erp_loc_a101';
        TRUNCATE TABLE silver.erp_loc_a101;

        PRINT '>> Inserting Data: silver.erp_loc_a101';

		TRUNCATE TABLE silver.erp_loc_a101;
		INSERT INTO silver.erp_loc_a101(
		cid,cntry)
		
		select REPLACE(cid,'-','') as cid,
			CASE 
				WHEN (cntry = 'DE')  THEN 'Germany'
				WHEN cntry = 'US' or cntry = 'USA' or UPPER(TRIM(cntry)) = 'UNITED STATES' THEN 'United States'
				WHEN cntry is NULL or cntry = '' then 'n/a'
				ELSE cntry
				END cntry
		FROM bronze.erp_loc_a101

        PRINT '>> Completed: silver.erp_loc_a101';
        PRINT '>> Duration (seconds): '
            + CAST(DATEDIFF(SECOND, @table_start_time, SYSDATETIME()) AS VARCHAR(20));

        -- ==========================================
        -- 6. ERP PRODUCT CATEGORY
        -- ==========================================
        SET @table_start_time = SYSDATETIME();

        PRINT '>> Truncating Table: silver.erp_px_cat_g1v2';
        TRUNCATE TABLE silver.erp_px_cat_g1v2;

        PRINT '>> Inserting Data: silver.erp_px_cat_g1v2';

		   TRUNCATE TABLE silver.erp_px_cat_g1v2;
		INSERT INTO silver.erp_px_cat_g1v2(
		id,cat,subcat,maintenance)
		select id,cat,subcat,maintenance
		from bronze.erp_px_cat_g1v2

        PRINT '>> Completed: silver.erp_px_cat_g1v2';
        PRINT '>> Duration (seconds): '
            + CAST(DATEDIFF(SECOND, @table_start_time, SYSDATETIME()) AS VARCHAR(20));

        PRINT '================================================';
        PRINT 'SILVER LAYER LOAD COMPLETED SUCCESSFULLY';
        PRINT 'End Time: ' + CONVERT(VARCHAR(30), SYSDATETIME(), 121);
        PRINT 'Total Duration (seconds): '
            + CAST(DATEDIFF(SECOND, @batch_start_time, SYSDATETIME()) AS VARCHAR(20));
        PRINT '================================================';

    END TRY
    BEGIN CATCH

        PRINT '================================================';
        PRINT 'ERROR OCCURRED DURING SILVER LAYER LOAD';
        PRINT 'Error Number: ' + CAST(ERROR_NUMBER() AS VARCHAR(20));
        PRINT 'Error Message: ' + ERROR_MESSAGE();
        PRINT 'Error Line: ' + CAST(ERROR_LINE() AS VARCHAR(20));
        PRINT 'Error Time: ' + CONVERT(VARCHAR(30), SYSDATETIME(), 121);
        PRINT '================================================';

        THROW;

    END CATCH
END;
GO

EXEC silver.load_silver;

