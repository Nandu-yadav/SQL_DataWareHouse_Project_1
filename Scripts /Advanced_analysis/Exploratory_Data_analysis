
USE Datawarehouse
--1. Find the total customers by countries
SELECT 
	country,
	COUNT(customer_key) AS total_customers
	FROM gold.dim_customers
	GROUP BY country
	ORDER BY total_customers Desc
--Find the total number of customers by gender
SELECT 
    gender,
	count(c.gender) as total_no_customers
	from gold.dim_customers c
	GROUP BY gender
	order by total_no_customers desc

-- Find total products by category
SELECT 
    category,
	count(category) as total_no_products
	from gold.dim_products p
	GROUP BY category
	order by total_no_products desc
--What is the Average costs in each category
SELECT 
    category,
	AVG(cost) as avg_cost
	from gold.dim_products p
	GROUP BY category
	order by avg_cost desc
--What is the Total Revenue in each category
SELECT 
	p.category,
	SUM(f.sales_amount) as total_revenue
	from gold.fact_sales f
	LEFT JOIN gold.dim_products p
	ON p.product_key = f.product_key
	GROUP BY p.category
	ORDER BY total_revenue DESC

--What is the Total Revenue by each customer  IMPORTANT
SELECT 
	c.customer_key,
	c.first_name,
	c.last_name,
	SUM(f.sales_amount) as total_revenue
	from gold.fact_sales f
	LEFT JOIN gold.dim_customers c
	ON c.customer_key = f.customer_key
	GROUP BY c.customer_key,
	c.first_name,
	c.last_name
	ORDER BY total_revenue DESC


--What is the Distribution of sold items across countries   IMPORTANT
SELECT 
	c.country,
	SUM(f.quantity)  as total_sold
	FROM gold.fact_sales f
	LEFT JOIN gold.dim_customers c
	ON c.customer_key = f.customer_key
	GROUP BY c.country
	ORDER BY total_sold DESC
